<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup / device-transfer rules.
    PendingIntents are system-owned and cannot be backed up; alerts are restored from Room.
    DataStore contains theme and live-update settings; SharedPreferences keeps AppCompat locales.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
